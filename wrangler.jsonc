{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "google-search-console-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-01-12",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"vars": {
		"GSC_API_BASE": "https://searchconsole.googleapis.com/",
		"EXECUTE_TIMEOUT_MS": "30000",
		"DAILY_EXECUTE_CAP": "500",
		"MCP_RESOURCE": "https://google-search-console-mcp.arnolddlv-1e4.workers.dev/mcp"
	},
	// Local dev overrides MCP_RESOURCE in .dev.vars. GOOGLE_CLIENT_ID and
	// GOOGLE_CLIENT_SECRET come from .dev.vars locally
	// and from `wrangler secret put` when deployed.
	"worker_loaders": [{ "binding": "LOADER" }],
	// workers-oauth-provider requires this exact binding name. It also holds
	// login state, the refresh lock and the daily cap counters.
	// Created by `wrangler deploy` on 2026-09-26 as google-search-console-mcp-oauth-kv.
	"kv_namespaces": [{ "binding": "OAUTH_KV", "id": "fcd0111f12d446099215353c4cc59004" }],
	"workers_dev": true,
	"observability": { "logs": { "enabled": true } },
	"dev": { "port": 2530 }
}
